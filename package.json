{
  "name": "guide-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --stream dev",
    "dev:console": "pnpm --filter @guide/console dev",
    "dev:agent": "pnpm --filter @guide/agent dev",
    "dev:api": "pnpm --filter @guide/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0"
  }
}
